  "scripts": {
    "prepare": "is-ci || husky",
    "analyze": "webpack-bundle-analyzer build/stats.json",
    "build": "tsc --noEmit && webpack --config webpack.prod.js",
    "build:dev": "webpack --config webpack.dev.js",
    "format": "prettier --single-quote --write \"{src,public}/**/*.{ts,tsx,html}\"",
    "lint": "eslint --fix \"{src,public}/**/*.{ts,tsx}\"",
    "refresh-token": "./scripts/refresh-token.sh",
    "start": "webpack serve --config webpack.dev.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "playwright": "npx playwright install chromium && playwright test",
    "playwright:visual": "npx playwright install chromium && playwright test --ui",
    "playwright:debug": "npx playwright install chromium && playwright test --debug",
    "playwright:report": "playwright show-report ./playwright/playwright-report"
  },
